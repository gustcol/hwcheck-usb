[Unit]
Description=Hardware check on tty1
After=systemd-user-sessions.service systemd-udev-settle.service live-config.service
Conflicts=getty@tty1.service
Before=getty@tty1.service

[Service]
Type=idle
ExecStart=/usr/local/bin/hwcheck
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
Environment=TERM=linux HOME=/root
WorkingDirectory=/root
Restart=no

[Install]
WantedBy=multi-user.target
